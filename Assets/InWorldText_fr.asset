  - m_Id: 19908501504
    m_Localized: "D\xE9plasse toi avec \nQ et D"
    m_Metadata:
      m_Items: []
  - m_Id: 350432239616
    m_Localized: "Espace \npour saut\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 600760885248
    m_Localized: "Certaines profonodeurs sont trop \ninsondable pour toi ..."
    m_Metadata:
      m_Items: []
  - m_Id: 809486229504
    m_Localized: Tu est fragile.
    m_Metadata:
      m_Items: []
  - m_Id: 990084571136
    m_Localized: "Un Tas de viande, tu pourrais \nr\xE9cup\xE9rer quelque ... \npi\xE8ces"
    m_Metadata:
      m_Items: []
  - m_Id: 1228362981376
    m_Localized: "Change tes corp avec\n la touche C"
    m_Metadata:
      m_Items: []
  - m_Id: 1382117777408
    m_Localized: "Les sphincters peuvent \nbloquer le passage\n"
    m_Metadata:
      m_Items: []
  - m_Id: 1555770351616
    m_Localized: Suis le nerf...
    m_Metadata:
      m_Items: []
  - m_Id: 1771282079744
    m_Localized: "D\xE9truisez l'organe "
    m_Metadata:
      m_Items: []
  - m_Id: 1903054528512
    m_Localized: Avec le clique gauche
    m_Metadata:
      m_Items: []
  - m_Id: 2051633553408
    m_Localized: "Il pourrait te blaiss\xE9 ... \nt'arracher des membres ..."
    m_Metadata:
      m_Items: []
  - m_Id: 2303249850368
    m_Localized: "Tu commence \xE0 \nprendre forme"
    m_Metadata:
      m_Items: []
  - m_Id: 2505042010112
    m_Localized: "Peut-\xEAtre vivras tu encore \nun peu ..."
    m_Metadata:
      m_Items: []
  - m_Id: 2628350353408
    m_Localized: 'Ma chose '
